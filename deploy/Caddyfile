# Caddy : HTTPS automatique (Let's Encrypt) et la règle d'accès.
#
# Depuis Internet, seul le jeu répond : la gestion, son API, ses
# WebSockets et ses traductions répondent 403 hors du réseau local.
# Depuis le réseau local : tout, sur https://<IP du Pi>:8443/
# (certificat local de Caddy : le navigateur avertit la première fois).

{
	email {$ACME_EMAIL}
}

(commun) {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	log {
		output stdout
		format console
	}
}

(application) {
	handle_path /static/* {
		root * /srv/static
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle_path /game-media/* {
		root * /srv/game-media
		header Cache-Control "public, max-age=86400"
		file_server
	}
	handle {
		reverse_proxy web:8000
	}
}

# Le site public.
{$SITE_DOMAIN} {
	import commun
	header Strict-Transport-Security "max-age=31536000"

	@reserve {
		not remote_ip private_ranges
		path /gestion /gestion/* /ws/* /api/generic/* /jsi18n/*
	}
	route {
		respond @reserve "Accès réservé au réseau local." 403
		import application
	}
}

# L'accès réseau local (gestion comprise).
https://{$LAN_HOST}:8443 {
	tls internal
	import commun

	@exterieur not remote_ip private_ranges
	route {
		respond @exterieur "Accès réservé au réseau local." 403
		import application
	}
}
